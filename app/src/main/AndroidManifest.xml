<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
      Declared so the privileged half can be reached either through Shizuku or, for
      power users, by granting them directly over adb. CoverDeck never assumes it
      holds these in its own process - everything privileged runs in the shell-UID
      user service.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.hardware.type.foldable" android:required="false" />

    <application
        android:name=".CoverDeckApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.CoverDeck">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.CoverDeck"
            tools:ignore="DiscouragedApi"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Cover recents. An activity rather than an overlay: Settings force-hides app
          overlays, and activities are not affected. Exported only because the Shizuku
          helper launches it as shell, and shell may not start non-exported activities of
          another app; it shows nothing sensitive and acts only through CoverDeck.
          Its own task affinity keeps it from dragging the main CoverDeck task along.
        -->
        <activity
            android:name=".recents.CoverRecentsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.raihan.coverdeck.recents"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.CoverDeck.Recents"
            tools:ignore="DiscouragedApi"
            android:configChanges="density|fontScale|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode|layoutDirection" />

        <!--
          Hosts cover auto-rotate, the Home long-press watcher and the mirror surface. The
          mirror is a window on display 1, not an activity, so a device-state change cannot
          relocate it to the inner screen.
        -->
        <service
            android:name=".overlay.CoverDeckService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="cover_screen_window_controller" />
        </service>        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
